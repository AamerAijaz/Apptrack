{
  "name": "apptrack",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-09",
  "secrets": {
    "required": ["API_ORIGIN"]
  },
  "vars": {},
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
